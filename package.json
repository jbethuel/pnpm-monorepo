{
  "name": "pnpm-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "pnpm --filter api",
    "core": "pnpm --filter core",
    "ui": "pnpm --filter ui",
    "web": "pnpm --filter web",
    "precheck": "pnpm prettier:check && pnpm lint:check",
    "typecheck": "pnpm -r typecheck",
    "lint:check": "oxlint --max-warnings=0",
    "prettier:check": "prettier --check ./apps ./packages",
    "prettier:write": "prettier --write ./apps ./packages"
  },
  "devDependencies": {
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  }
}
