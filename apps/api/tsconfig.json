{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@monorepo/ts-config/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "build"]
}
